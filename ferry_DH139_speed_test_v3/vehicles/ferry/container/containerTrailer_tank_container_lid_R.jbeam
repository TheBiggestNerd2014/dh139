{
"containerTrailer_tank_container_R_lid_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Lid",
        "value":100,
    },
    "slotType" : "containerTrailer_tank_container_R_lid_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["container_tank_lid_B", ["container_tank_R_lid_B"]],
         ["container_tank_lid_B_lockpin_L", ["container_tank_R_lid_B"]],
         ["container_tank_lid_B_lockpin_R", ["container_tank_R_lid_B"]],
    ],
    "triggers":[
        ["id",        "label", "idRef:", "idX:", "idY:", "type", "size",                           "baseRotation",         "rotation",            "translation",         "baseTranslation"],
        ["lid_R_B_L",   "",      "tlidR1l", "tlidR2l", "tlidR1r", "box",  {"x":0.055, "y":0.045, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.08, "y":-0.02, "z":-0.055}],
        ["lid_R_B_R",   "",      "tlidR1r", "tlidR2r", "tlidR1l", "box",  {"x":0.055, "y":0.045, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.08, "y":-0.02, "z": 0.010}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["lid_R_B_L", "action0", "lidBLatch_R"],
        ["lid_R_B_R", "action0", "lidBLatch_R"],
    ],
    "events":[
        ["id", "title", "desc"],
        ["lidBLatch_R", "ui.inputActions.common.toolboxLatch.title", "ui.inputActions.common.toolboxLatch.description", {"onUp":"controller.getControllerSafe('lidBCoupler_R').toggleGroup()"}],
    ],
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"lidBCoupler_R"}],
    ],
    "lidBCoupler_R":{
        "groupType": "manualClose",
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["tbxR1r",  "tlidR1r",    24000,                     0.01,                   0.005,                      0.2,                 0.2,                    "lid_R_B_latch"],
            ["tbxR1l",  "tlidR1l",    24000,                     0.01,                   0.005,                      0.2,                 0.2,                    "lid_R_B_latch"],
        ]
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["tlidR1r","tlidR1l"]
        "attachSoundEvent": "event:>Vehicle>Latches>Special>toolbox_01_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Special>toolbox_01_open",
        "breakSoundEvent":""
        "openForceMagnitude": 10,
        "openForceDuration": 0.5,
        "closeForceMagnitude": 1200,
        "closeForceDuration": 0.5,
    },
    "glowMap":{
        "Container_Tank_lockpin":{"simpleFunction":"lidBCoupler_notAttached", "off":"Container_Tank", "on":"invis"},
    },
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"frictionCoef":0.5},
        {"collision":true},
        {"selfCollision":false},
        {"nodeMaterial":"|NM_METAL"},
        //lid
        {"group":"container_tank_R_lid_B"},
        {"nodeWeight":4.0},
        ["tlidR1r", 0.4, 0.048, 0.104],
        ["tlidR1l",-0.4, 0.048, 0.104],
        ["tlidR2r", 0.4, 0.048, 0.456, {"couplerTag":"lid_R_B_hinge_R", "couplerStrength":61000, "couplerRadius":0.1, "couplerStartRadius":0.1, "couplerLock":true, "breakGroup":"lid_R_B_hinge"}],
        ["tlidR2l",-0.4, 0.048, 0.456, {"couplerTag":"lid_R_B_hinge_L", "couplerStrength":61000, "couplerRadius":0.1, "couplerStartRadius":0.1, "couplerLock":true, "breakGroup":"lid_R_B_hinge"}],
        {"collision":false},
        {"group":""},
        {"nodeWeight":6.0},
        ["tlidRr1", 0, 0.250, 0.285],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":4001000,"beamDamp":400},
          {"beamDeform":61000,"beamStrength":"FLT_MAX"},
          //main shape
          ["tlidR1r","tlidR1l"],
          ["tlidR2r","tlidR2l"],
          ["tlidR1r","tlidR2r"],
          ["tlidR1l","tlidR2l"],

          //cross
          {"beamDeform":21000,"beamStrength":"FLT_MAX"},
          ["tlidR1r","tlidR2l"],
          ["tlidR1l","tlidR2r"],

          //rigidifier
          {"beamDeform":15000,"beamStrength":"FLT_MAX"},
          ["tlidR1r","tlidRr1"],
          ["tlidR1l","tlidRr1"],
          ["tlidR2r","tlidRr1"],
          ["tlidR2l","tlidRr1"],

          //support beams
          {"beamPrecompression":2.0, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":1000,"beamDamp":200},
          {"beamDeform":122000,"beamStrength":"FLT_MAX"},
          {"breakGroup":"lid_R_B_latch"},
          ["tlidR1l","tbxR4l"],
          ["tlidR1r","tbxR4r"],
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        {"groundModel":"metal"},
        {"dragCoef":15},
        {"group":"tank_container_lid"},
        ["tlidR2l","tlidR1l","tlidR1r"],
        ["tlidR2l","tlidR1r","tlidR2r"],
    ],
},

