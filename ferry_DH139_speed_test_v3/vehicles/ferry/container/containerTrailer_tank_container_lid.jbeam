{
"containerTrailer_tank_container_lid_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Lid",
        "value":100,
    },
    "slotType" : "containerTrailer_tank_container_lid_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["container_tank_lid_B", ["container_tank_lid_B"]],
         ["container_tank_lid_B_lockpin_L", ["container_tank_lid_B"]],
         ["container_tank_lid_B_lockpin_R", ["container_tank_lid_B"]],
    ],
    "triggers":[
        ["id",        "label", "idRef:", "idX:", "idY:", "type", "size",                           "baseRotation",         "rotation",            "translation",         "baseTranslation"],
        ["lid_B_L",   "",      "tlid1l", "tlid2l", "tlid1r", "box",  {"x":0.055, "y":0.045, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.08, "y":-0.02, "z":-0.055}],
        ["lid_B_R",   "",      "tlid1r", "tlid2r", "tlid1l", "box",  {"x":0.055, "y":0.045, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.08, "y":-0.02, "z": 0.010}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["lid_B_L", "action0", "lidBLatch"],
        ["lid_B_R", "action0", "lidBLatch"],
    ],
    "events":[
        ["id", "title", "desc"],
        ["lidBLatch", "ui.inputActions.common.toolboxLatch.title", "ui.inputActions.common.toolboxLatch.description", {"onUp":"controller.getControllerSafe('lidBCoupler').toggleGroup()"}],
    ],
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"lidBCoupler"}],
    ],
    "lidBCoupler":{
        "groupType": "manualClose",
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["tbx1r",  "tlid1r",    24000,                     0.01,                   0.005,                      0.2,                 0.2,                    "lid_B_latch"],
            ["tbx1l",  "tlid1l",    24000,                     0.01,                   0.005,                      0.2,                 0.2,                    "lid_B_latch"],
        ]
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["tlid1r","tlid1l"]
        "attachSoundEvent": "event:>Vehicle>Latches>Special>toolbox_01_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Special>toolbox_01_open",
        "breakSoundEvent":""
        "openForceMagnitude": 10,
        "openForceDuration": 0.5,
        "closeForceMagnitude": 1200,
        "closeForceDuration": 0.5,
    },
    "glowMap":{
        "Container_Tank_lockpin":{"simpleFunction":"lidBCoupler_notAttached", "off":"Container_Tank", "on":"invis"},
    },
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"frictionCoef":0.5},
        {"collision":true},
        {"selfCollision":false},
        {"nodeMaterial":"|NM_METAL"},
        //lid
        {"group":"container_tank_lid_B"},
        {"nodeWeight":4.0},
        ["tlid1r", 0.4, 0.048, 0.104],
        ["tlid1l",-0.4, 0.048, 0.104],
        ["tlid2r", 0.4, 0.048, 0.456, {"couplerTag":"lid_B_hinge_R", "couplerStrength":61000, "couplerRadius":0.1, "couplerStartRadius":0.1, "couplerLock":true, "breakGroup":"lid_B_hinge"}],
        ["tlid2l",-0.4, 0.048, 0.456, {"couplerTag":"lid_B_hinge_L", "couplerStrength":61000, "couplerRadius":0.1, "couplerStartRadius":0.1, "couplerLock":true, "breakGroup":"lid_B_hinge"}],
        {"collision":false},
        {"group":""},
        {"nodeWeight":6.0},
        ["tlidr1", 0, 0.250, 0.285],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":4001000,"beamDamp":400},
          {"beamDeform":61000,"beamStrength":"FLT_MAX"},
          //main shape
          ["tlid1r","tlid1l"],
          ["tlid2r","tlid2l"],
          ["tlid1r","tlid2r"],
          ["tlid1l","tlid2l"],

          //cross
          {"beamDeform":21000,"beamStrength":"FLT_MAX"},
          ["tlid1r","tlid2l"],
          ["tlid1l","tlid2r"],

          //rigidifier
          {"beamDeform":15000,"beamStrength":"FLT_MAX"},
          ["tlid1r","tlidr1"],
          ["tlid1l","tlidr1"],
          ["tlid2r","tlidr1"],
          ["tlid2l","tlidr1"],

          //support beams
          {"beamPrecompression":2.0, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":1000,"beamDamp":200},
          {"beamDeform":122000,"beamStrength":"FLT_MAX"},
          {"breakGroup":"lid_B_latch"},
          ["tlid1l","tbx4l"],
          ["tlid1r","tbx4r"],
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        {"groundModel":"metal"},
        {"dragCoef":15},
        {"group":"tank_container_lid"},
        ["tlid2l","tlid1l","tlid1r"],
        ["tlid2l","tlid1r","tlid2r"],
    ],
},

