        ["tlid4l",-0.5, 1.396, 2.524, {"couplerTag":"lid_T1_hinge_L", "couplerStrength":61000, "couplerRadius":0.1, "couplerStartRadius":0.1, "couplerLock":true, "breakGroup":"lid_T1_hinge"}],
