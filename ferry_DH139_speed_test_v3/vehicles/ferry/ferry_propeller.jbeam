        "idleRPM":875,
        "maxRPM":8400,
        "revLimiterRPM":8000,
        "revLimiterType":"soft",
        "revLimiterSmoothOvershootRPM":300,
        "revLimiterRPMDrop":100,
        "inertia":3.82,
        "friction":207,
        "dynamicFriction":0.5,
        "engineBrakeTorque":80,
        "burnEfficiency":[
            [0.00, 0.13],
            [0.05, 0.28],
            [0.40, 0.37],
            [0.70, 0.45],
            [1.00, 0.31],
        ],
        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",
        "particulates":0.1,
        "instantAfterFireCoef": 0.15,
        "sustainedAfterFireCoef": 0.05,
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminium",
        "oilVolume":12,
        "engineBlockAirCoolingEfficiency":70,
        "radiatorFanType":"mechanical",
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Mechanical_01",
        "radiatorFanVolume": 0.75,
        "radiatorFanMaxAirSpeed":2,
        "thermostatTemperature":90,
        "oilThermostatTemperature":100,
        "cylinderWallTemperatureDamageThreshold":310,
        "headGasketDamageThreshold":1700000,
        "pistonRingDamageThreshold":1700000,
        "connectingRodDamageThreshold":2200000,
        "maxTorqueRating": 20000,
        "maxOverTorqueDamage": 16000,
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",
        "starterSample":"event:>Engine>Starter>i6diesel_semi_eng",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i6diesel_semi_eng",
        "starterVolume":0.76,
        "shutOffVolumeEngine":0.76,
        "starterThrottleKillTime":1.2,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":0.8,
        // Stern deck nodes. The speedboat ids are not on this hull.
        "torqueReactionNodes:":["fhl110", "fh113", "fhr110"],
    },
    "soundConfig": {
        "sampleName": "I6D_14900cc_01_1969_engine",
        "intakeMuffling": 0.8,

        "mainGain": -3,
        "onLoadGain": 1.0,
        "offLoadGain": 0.7,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": 0,
        "lowShelfFreq": 100,

        // Low-pass. There is no lowPass control; a negative high shelf
        // cuts everything above highShelfFreq. The limiter is at 8000 rpm,
        // so the shelf sits lower to keep the pitched sample from squealing.
        "highShelfGain": -16,
        "highShelfFreq": 1400,

        "eqLowGain": 0,
        "eqLowFreq": 350,
        "eqLowWidth": 0.25,

        // Extra cut through the squeak band, wide enough to act like a
        // second stage of the same low-pass.
        "eqHighGain": -12,
        "eqHighFreq": 3600,
        "eqHighWidth": 0.7,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": 0,
    },
    "soundConfigExhaust": {
        "sampleName": "I6D_14900cc_01_1969_exhaust",

        "mainGain": 6,
        "onLoadGain": 1.0,
        "offLoadGain": 0.30,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": -10,
        "lowShelfFreq": 100,

        // Was +6 dB above 2500 Hz, which turned the max-rev whine up.
        // Same low-pass as the engine layer: roll off the top, keep the body.
        "highShelfGain": -16,
        "highShelfFreq": 1200,

        "eqLowGain": 0,
        "eqLowFreq": 100,
        "eqLowWidth": 0.1,

        "eqHighGain": -12,
        "eqHighFreq": 3000,
        "eqHighWidth": 0.7,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": -12,
    },
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-1, 0, 1],
        "parkLockTorque":2000,
        "oneWayViscousCoef":8,
        "friction":1,
        "dynamicFriction":0.005,
        "torqueLossCoef":0.014,
        "gearWhineCoefsInput":  [1.00, 0.00, 1.00],
