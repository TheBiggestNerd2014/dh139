        "idleRPM":700,
        "maxRPM":3000,
        "revLimiterRPM":2500,
        "revLimiterType":"soft",
        "revLimiterSmoothOvershootRPM":120,
        "revLimiterRPMDrop":80,
        "inertia":8,
        "friction":207,
        "dynamicFriction":0.5,
        "engineBrakeTorque":80,
        "burnEfficiency":[
            [0.00, 0.13],
            [0.05, 0.28],
            [0.40, 0.37],
            [0.70, 0.45],
            [1.00, 0.31],
        ],
        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",
        "particulates":0.1,
        "instantAfterFireCoef": 0,
        "sustainedAfterFireCoef": 0,
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminium",
        "oilVolume":12,
        "engineBlockAirCoolingEfficiency":70,
        "radiatorFanType":"mechanical",
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Mechanical_01",
        "radiatorFanVolume": 0.75,
        "radiatorFanMaxAirSpeed":2,
        "thermostatTemperature":90,
        "oilThermostatTemperature":100,
        "cylinderWallTemperatureDamageThreshold":310,
        "headGasketDamageThreshold":1700000,
        "pistonRingDamageThreshold":1700000,
        "connectingRodDamageThreshold":2200000,
        "maxTorqueRating": 20000,
        "maxOverTorqueDamage": 16000,
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",
        "starterSample":"event:>Engine>Starter>i6diesel_semi_eng",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i6diesel_semi_eng",
        "starterVolume":0.76,
        "shutOffVolumeEngine":0.76,
        "starterThrottleKillTime":1.2,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":0.8,
        // Stern deck nodes. The speedboat ids are not on this hull.
        "torqueReactionNodes:":["fhl110", "fh113", "fhr110"],
    },
    "soundConfig": {
        "sampleName": "I6D_14900cc_01_1969_engine",
        "intakeMuffling": 0.8,

        "mainGain": -3,
        "onLoadGain": 1.0,
        "offLoadGain": 0.7,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": 0,
        "lowShelfFreq": 100,

        // Low-pass. There is no lowPass control; a negative high shelf
        // cuts everything above highShelfFreq so the diesel sample stays dull.
        "highShelfGain": -30,
        "highShelfFreq": 450,

        "eqLowGain": 0,
        "eqLowFreq": 350,
        "eqLowWidth": 0.25,

        // Extra cut through the squeak band, wide enough to act like a
        // second stage of the same low-pass.
        "eqHighGain": -18,
        "eqHighFreq": 1800,
        "eqHighWidth": 0.8,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": 0,
    },
    "soundConfigExhaust": {
        "sampleName": "I6D_14900cc_01_1969_exhaust",

        "mainGain": 6,
        "onLoadGain": 1.0,
        "offLoadGain": 0.30,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": -10,
        "lowShelfFreq": 100,

        // Was +6 dB above 2500 Hz, which turned the max-rev whine up.
        // Same low-pass as the engine layer: roll off the top, keep the body.
        "highShelfGain": -30,
        "highShelfFreq": 400,

        "eqLowGain": 0,
        "eqLowFreq": 100,
        "eqLowWidth": 0.1,

        "eqHighGain": -18,
        "eqHighFreq": 1600,
        "eqHighWidth": 0.8,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": -12,
    },
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-1, 0, 1],
        "parkLockTorque":2000,
        "oneWayViscousCoef":8,
        "friction":1,
        "dynamicFriction":0.005,
        "torqueLossCoef":0.014,
        "gearWhineCoefsInput":  [1.00, 0.00, 1.00],
        "gearWhineCoefsOutput": [0.00, 0.00, 1.00],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>semi_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>semi_01>twine_out",
        "forwardInputPitchCoef":1.4,
        "forwardOutputPitchCoef":1.4,
        "gearWhineInputPitchCoefSmoothing":75,
        "gearWhineOutputPitchCoefSmoothing":75,
        "gearWhineInputVolumeCoefSmoothing":20,
        "gearWhineOutputVolumeCoefSmoothing":20,
    },
    "vehicleController": {
        "automaticModes":"PRND",
        "useSmartAggressionCalculation":false,
        "calculateOptimalLoadShiftPoints":false,
        "gearboxDecisionSmoothingDown":2,
        "gearboxDecisionSmoothingUp":2,
        "throttleCoefWhileShifting":1,
        // One forward gear. These stay under the diesel idle range so a
        // low cruise rpm cannot drop the box into neutral and unload the props.
        "lowShiftDownRPM":400,
        "lowShiftUpRPM":650,
        "highShiftDownRPM":1400,
        "highShiftUpRPM":2800,
        "transmissionGearChangeDelay":0.2,
        "transmissionShiftDelay":0.25,
        // Only one forward gear. A min gear of 2 keeps the converter from locking
        // and letting the crank run away from the hull again.
        "torqueConverterLockupRPM":20000,
        "torqueConverterLockupMinGear":2,
    },
    "rotators":[
        ["name","[group]:","node1:","node2:","nodeArm:","wheelDir"],
        {"radius":0.80},
        {"rotatorType":"rotator"},
        {"enableBrakeThermals":false},
        {"brakeTorque":5000},
        {"parkingTorque":5000},
        {"useDefaultBrakeInput":true},
        {"speedo": false},
        ["propeller_L", ["propellerL"], "bplax1", "bplax0", "fh115", 1, {"speedo":false, "nodeCoupling:":"bplax1", "torqueCoupling:":"bplax0", "torqueArm:":"fh115"}],
        ["propeller_R", ["propellerR"], "bprax1", "bprax0", "fh115",-1, {"speedo":false, "nodeCoupling:":"bprax1", "torqueCoupling:":"bprax0", "torqueArm:":"fh115"}],
    ],
    "energyStorage": [
        ["type", "name"],
        ["fuelTank", "mainTank"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$fuel", "range", "L", "Chassis", 5000, 0, 5000, "Fuel Volume", "Initial fuel volume", {"stepDis":10}],
    ],
    "mainTank": {
        "energyType":"gasoline",
        "fuelCapacity": 5000,
        "startingFuelCapacity": "$fuel",
        "breakTriggerBeam": "engine",
    },
    "nodes": [
        ["id",   "posX", "posY", "posZ"],
        // Speedboat blades, scaled to the ferry prop radius and moved aft.
        // Every vertex of the mesh uses this same move, so the blades are not stretched.
        // The blades sit about 2.1 m under the waterline. The housings
        // rise from the hubs to the keel, so the struts are attached, not floating.
        {"collision":false},
        {"selfCollision":false},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":40},
        {"group":"propAxleL"},
        ["bplax0", 1.6000, 20.4000, -2.8600],
