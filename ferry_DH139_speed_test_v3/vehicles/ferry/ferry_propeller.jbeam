{
"ferry_propeller": {
    "information":{
        "authors":"Belasco Heavy Industries",
        "name":"DH-142 Single Engine",
        "value":5000,
    },
    "slotType" : "ferry_propeller",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        // PropellerR mesh sits on the port nodes, PropellerL on the starboard nodes.
        // Only the spinning blade nodes. The hub stays still, and including it
        // was twisting the mesh every revolution.
        ["PropellerR", ["propellerL"]],
        ["PropellerL", ["propellerR"]],
        // Housings are skinned to their own cage. The shaft is not in this
        // group, so steering the shaft does not crumple the nozzle.
        ["PropMountR", ["propMountL"]],
        ["PropMountL", ["propMountR"]]
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
        ["torqueConverter", "torqueConverter", "mainEngine", 1],
        ["automaticGearbox", "gearbox", "torqueConverter", 1],
        // 4:1 keeps prop speed where the old 10:1 was at 5000 rpm, while the
        // crank stays in the low range this diesel sample was recorded for.
        ["differential", "differential_R", "gearbox", 1, {"diffType":"locked", "lockTorque":200000, "gearRatio":4, "uiName":"Rear Differential"}],
        ["shaft", "propellerLShaft", "differential_R", 1, {"connectedWheel":"propeller_L", "breakTriggerBeam":"propeller_L", "uiName":"Left Propeller"}],
        ["shaft", "propellerRShaft", "differential_R", 2, {"connectedWheel":"propeller_R", "breakTriggerBeam":"propeller_R", "uiName":"Right Propeller"}],
    ],
    "torqueConverter": {
        "uiName":"Torque Converter",
        // The speedboat converter could not absorb this crank. Capacity grows
        // with rpm squared, so the engine had no load until it was on the limiter
        // and the hull was still accelerating. This diameter loads the crank
        // through the speed governor's range instead of letting it flare to 8000.
        "converterDiameter":0.45,
        "fluidDensity":845,
        "converterStiffness":15,
        "couplingAVRatio":0.9,
        "stallTorqueRatio":1.6,
        "converterTorque":20000,
        "lockupClutchTorque":0,
    },
    "mainEngine":{
        // Single-engine curve from the speedboat, scaled onto these propellers.
        // The shape still climbs to 6600 rpm and then falls off. Peak is 12000 Nm.
        // The rev limiter below keeps the running rpm in the diesel range.
        "torque":[
            ["rpm", "torque"],
            [0, 0],
            [100, 83],
            [500, 5570],
            [900, 7313],
            [1000, 7522],
            [1100, 7706],
            [1200, 7906],
            [1300, 8048],
            [1400, 8175],
            [1500, 8316],
            [1600, 8465],
            [1700, 8558],
