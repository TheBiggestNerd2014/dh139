{
"ferry_propeller": {
    "information":{
        "authors":"Belasco Heavy Industries",
        "name":"DH-142 Single Engine",
        "value":5000,
    },
    "slotType" : "ferry_propeller",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        // PropellerR mesh sits on the port nodes, PropellerL on the starboard nodes.
        ["PropellerR", ["propellerL"]],
        ["PropellerL", ["propellerR"]],
        // Housings use the shaft nodes for shape only. They are not beamed to
        // the shafts, so a spinning blade cannot rattle the strut.
        ["PropMountR", ["propMountL", "propAxleL"]],
        ["PropMountL", ["propMountR", "propAxleR"]]
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
        ["torqueConverter", "torqueConverter", "mainEngine", 1],
        ["automaticGearbox", "gearbox", "torqueConverter", 1],
        ["differential", "differential_R", "gearbox", 1, {"diffType":"locked", "lockTorque":200000, "gearRatio":10, "uiName":"Rear Differential"}],
        ["shaft", "propellerLShaft", "differential_R", 1, {"connectedWheel":"propeller_L", "breakTriggerBeam":"propeller_L", "uiName":"Left Propeller"}],
        ["shaft", "propellerRShaft", "differential_R", 2, {"connectedWheel":"propeller_R", "breakTriggerBeam":"propeller_R", "uiName":"Right Propeller"}],
    ],
    "torqueConverter": {
        "uiName":"Torque Converter",
        // The speedboat converter could not absorb this crank. Capacity grows
        // with rpm squared, so the engine had no load until it was on the limiter
        // and the hull was still accelerating. This diameter loads the crank
        // through the speed governor's range instead of letting it flare to 8000.
        "converterDiameter":0.45,
        "fluidDensity":845,
        "converterStiffness":15,
        "couplingAVRatio":0.9,
        "stallTorqueRatio":1.6,
        "converterTorque":20000,
        "lockupClutchTorque":0,
    },
    "mainEngine":{
        // Single-engine curve from the speedboat, scaled onto these propellers.
        // The shape still climbs to 6600 rpm and then falls off. Peak is 12000 Nm,
        // which these 10:1 propellers can turn without stalling the crank.
        "torque":[
            ["rpm", "torque"],
            [0, 0],
            [100, 83],
            [500, 5570],
            [900, 7313],
            [1000, 7522],
            [1100, 7706],
            [1200, 7906],
            [1300, 8048],
            [1400, 8175],
            [1500, 8316],
            [1600, 8465],
            [1700, 8558],
            [1800, 8644],
            [1900, 8736],
            [2000, 8788],
            [2100, 8859],
            [2200, 8940],
            [2300, 9014],
            [2400, 9083],
            [2500, 9190],
            [2600, 9298],
            [2700, 9406],
            [2800, 9452],
            [2900, 9553],
            [3000, 9618],
            [3100, 9673],
            [3200, 9744],
            [3300, 9806],
            [3400, 9915],
            [3500, 10018],
            [3600, 10126],
            [3700, 10187],
            [3800, 10243],
            [3900, 10300],
            [4000, 10387],
            [4100, 10459],
            [4200, 10572],
            [4300, 10684],
            [4400, 10803],
            [4500, 10896],
            [4600, 10988],
            [4700, 11079],
            [4800, 11149],
            [4900, 11190],
            [5000, 11203],
            [5100, 11288],
            [5200, 11352],
            [5300, 11371],
            [5400, 11437],
            [5500, 11464],
            [5600, 11501],
            [5700, 11538],
            [5800, 11594],
            [5900, 11651],
            [6000, 11730],
            [6100, 11791],
            [6200, 11845],
            [6300, 11874],
            [6400, 11964],
            [6500, 11997],
            [6600, 12000],
            [6700, 11998],
            [6800, 11992],
            [6900, 11970],
            [7000, 11943],
            [7100, 11910],
            [7200, 11880],
            [7300, 11823],
            [7400, 11765],
            [7500, 11698],
            [7600, 11634],
            [7700, 11567],
            [7800, 11495],
            [7900, 10578],
            [8000, 8806],
        ],
        "idleRPM":875,
        "maxRPM":8400,
        "revLimiterRPM":8000,
        "revLimiterType":"soft",
        "revLimiterSmoothOvershootRPM":300,
        "revLimiterRPMDrop":100,
        "inertia":8,
        "friction":207,
        "dynamicFriction":0.5,
        "engineBrakeTorque":80,
        "burnEfficiency":[
            [0.00, 0.13],
            [0.05, 0.28],
            [0.40, 0.37],
            [0.70, 0.45],
            [1.00, 0.31],
        ],
        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",
        "particulates":0.1,
        "instantAfterFireCoef": 0.15,
        "sustainedAfterFireCoef": 0.05,
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminium",
        "oilVolume":12,
        "engineBlockAirCoolingEfficiency":70,
        "radiatorFanType":"mechanical",
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Mechanical_01",
        "radiatorFanVolume": 0.75,
        "radiatorFanMaxAirSpeed":2,
        "thermostatTemperature":90,
        "oilThermostatTemperature":100,
        "cylinderWallTemperatureDamageThreshold":310,
        "headGasketDamageThreshold":1700000,
        "pistonRingDamageThreshold":1700000,
        "connectingRodDamageThreshold":2200000,
        "maxTorqueRating": 20000,
        "maxOverTorqueDamage": 16000,
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",
        "starterSample":"event:>Engine>Starter>i6diesel_semi_eng",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i6diesel_semi_eng",
        "starterVolume":0.76,
        "shutOffVolumeEngine":0.76,
        "starterThrottleKillTime":1.2,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":0.8,
        // Stern deck nodes. The speedboat ids are not on this hull.
        "torqueReactionNodes:":["fhl110", "fh113", "fhr110"],
    },
    "soundConfig": {
        "sampleName": "I6D_14900cc_01_1969_engine",
        "intakeMuffling": 0.8,

        "mainGain": -3,
        "onLoadGain": 1.0,
        "offLoadGain": 0.7,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": 0,
        "lowShelfFreq": 100,

        // Low-pass. There is no lowPass control; a negative high shelf
        // cuts everything above highShelfFreq. The limiter is at 8000 rpm,
        // so the shelf sits lower to keep the pitched sample from squealing.
        "highShelfGain": -16,
        "highShelfFreq": 1400,

        "eqLowGain": 0,
        "eqLowFreq": 350,
        "eqLowWidth": 0.25,

        // Extra cut through the squeak band, wide enough to act like a
        // second stage of the same low-pass.
        "eqHighGain": -12,
        "eqHighFreq": 3600,
        "eqHighWidth": 0.7,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": 0,
    },
    "soundConfigExhaust": {
        "sampleName": "I6D_14900cc_01_1969_exhaust",

        "mainGain": 6,
        "onLoadGain": 1.0,
        "offLoadGain": 0.30,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": -10,
        "lowShelfFreq": 100,

        // Was +6 dB above 2500 Hz, which turned the max-rev whine up.
        // Same low-pass as the engine layer: roll off the top, keep the body.
        "highShelfGain": -16,
        "highShelfFreq": 1200,

        "eqLowGain": 0,
        "eqLowFreq": 100,
        "eqLowWidth": 0.1,

        "eqHighGain": -12,
        "eqHighFreq": 3000,
        "eqHighWidth": 0.7,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": -12,
    },
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-1, 0, 1],
        "parkLockTorque":2000,
        "oneWayViscousCoef":8,
        "friction":1,
        "dynamicFriction":0.005,
        "torqueLossCoef":0.014,
        "gearWhineCoefsInput":  [1.00, 0.00, 1.00],
        "gearWhineCoefsOutput": [0.00, 0.00, 1.00],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>semi_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>semi_01>twine_out",
        "forwardInputPitchCoef":1.4,
        "forwardOutputPitchCoef":1.4,
        "gearWhineInputPitchCoefSmoothing":75,
        "gearWhineOutputPitchCoefSmoothing":75,
        "gearWhineInputVolumeCoefSmoothing":20,
        "gearWhineOutputVolumeCoefSmoothing":20,
    },
    "vehicleController": {
        "automaticModes":"PRND",
        "useSmartAggressionCalculation":false,
        "calculateOptimalLoadShiftPoints":true,
        "gearboxDecisionSmoothingDown":2,
        "gearboxDecisionSmoothingUp":2,
        "throttleCoefWhileShifting":1,
        "lowShiftDownRPM":1400,
        "lowShiftUpRPM":2700,
        "highShiftDownRPM":4500,
        "highShiftUpRPM":7200,
        "transmissionGearChangeDelay":0.2,
        "transmissionShiftDelay":0.25,
        // Only one forward gear. A min gear of 2 keeps the converter from locking
        // and letting the crank run away from the hull again.
        "torqueConverterLockupRPM":20000,
        "torqueConverterLockupMinGear":2,
    },
    "rotators":[
        ["name","[group]:","node1:","node2:","nodeArm:","wheelDir"],
        {"radius":0.7526},
        {"rotatorType":"rotator"},
        {"enableBrakeThermals":false},
        {"brakeTorque":5000},
        {"parkingTorque":5000},
        {"useDefaultBrakeInput":true},
        {"speedo": false},
        ["propeller_L", ["propellerL"], "bplax1", "bplax0", "fh115", 1, {"speedo":false, "nodeCoupling:":"bplax1", "torqueCoupling:":"bplax0", "torqueArm:":"fh115"}],
        ["propeller_R", ["propellerR"], "bprax1", "bprax0", "fh115",-1, {"speedo":false, "nodeCoupling:":"bprax1", "torqueCoupling:":"bprax0", "torqueArm:":"fh115"}],
    ],
    "energyStorage": [
        ["type", "name"],
        ["fuelTank", "mainTank"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$fuel", "range", "L", "Chassis", 5000, 0, 5000, "Fuel Volume", "Initial fuel volume", {"stepDis":10}],
    ],
    "mainTank": {
        "energyType":"gasoline",
        "fuelCapacity": 5000,
        "startingFuelCapacity": "$fuel",
        "breakTriggerBeam": "engine",
    },
    "nodes": [
        ["id",   "posX", "posY", "posZ"],
        // Speedboat blades, scaled to the ferry prop radius and moved aft.
        // Every vertex of the mesh uses this same move, so the blades are not stretched.
        // The blades sit about 2.1 m under the waterline. The housings
        // rise from the hubs to the keel, so the struts are attached, not floating.
        {"collision":false},
        {"selfCollision":false},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":40},
        {"group":"propAxleL"},
        ["bplax0", 1.6000, 20.2498, -2.8600],
