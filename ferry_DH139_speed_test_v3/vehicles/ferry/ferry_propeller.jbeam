{
"ferry_propeller": {
    "information":{
        "authors":"BeamNG",
        "name":"Engine & Propellers",
        "value":5000,
    },
    "slotType" : "ferry_propeller",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["propellerL", ["propellerL"]],
		["propellerR", ["propellerR"]]
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
        ["frictionClutch", "clutch", "mainEngine", 1],
        ["manualGearbox", "gearbox", "clutch", 1],
        ["differential", "differential_R", "gearbox", 1, {"diffType":"locked", "lockTorque":200000, "gearRatio":10, "uiName":"Rear Differential"}],
        ["shaft", "propellerLShaft", "differential_R", 1, {"connectedWheel":"propeller_L", "breakTriggerBeam":"propeller_L", "uiName":"Left Propeller"}],
        ["shaft", "propellerRShaft", "differential_R", 2, {"connectedWheel":"propeller_R", "breakTriggerBeam":"propeller_R", "uiName":"Right Propeller"}],
    ],
    "mainEngine":{
        // In-game the prop matched ~2000 Nm just over 2000 rpm. A curve that kept
        // climbing past the 8000 Nm damage rating broke the engine, which then
        // bogged near 1000 rpm. Stay under that rating and let the lighter blades
        // spin up instead.
        "torque":[
            ["rpm", "torque"],
            [0,      0],
            [400,  800],
            [800, 2000],
            [1200, 3500],
            [1600, 4800],
            [2000, 5500],
            [3000, 6000],
            [4000, 6000],
            [5000, 5800],
            [5400, 5200],
            [5600, 3500],
        ],
        "idleRPM":600,
        "maxRPM":5000,
        "revLimiterRPM":5000,
        "revLimiterType":"soft",
        "revLimiterSmoothOvershootRPM":200,
        "inertia":2.5,
        "friction":37,
        "idleRPMRoughness":300,
        "dynamicFriction":0.1,
        "engineBrakeTorque":120,
        //"burnEfficiency":0.35
        "burnEfficiency":[
            [0,   0.20],
            [0.1, 0.25],
            [0.3, 0.32],
            [0.4, 0.46],
            [0.7, 0.44],
            [1,   0.42],
        ],
        //fuel system
        "energyStorage": "mainTank",
        "requiredEnergyType":"diesel",

        //exhaust
        "particulates":0.15,
        "instantAfterFireCoef": 0.0,
        "sustainedAfterFireCoef": 0.0,

        //cooling and oil system
        "thermalsEnabled":true,
        "engineBlockMaterial":"iron",
        "oilVolume":25,
        "engineBlockAirCoolingEfficiency":70,
        "radiatorFanType":"mechanical",
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Mechanical_01"
        "radiatorFanVolume": 0.75,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":175,
        "headGasketDamageThreshold":1700000,
        "pistonRingDamageThreshold":1700000,
        "connectingRodDamageThreshold":2200000,
        "maxTorqueRating": 25000,
        "maxOverTorqueDamage": 20000,

        //node beam interface
        "breakTriggerBeam":"engine",
        "uiName":"Engine",

        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>i6diesel_semi_eng",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i6diesel_semi_eng",
        "starterVolume":0.76,
        "shutOffVolumeEngine":0.76,
        "starterThrottleKillTime":1.2,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":0.8,

        "turbocharger":"turbocharger",
        "$+particulates":0.4,

        "torqueModMult":[
            ["rpm", "torque"],
            [0,    1.00],
            [5600, 1.00],
        ],
        //max rpm physically capable of
        "$+maxRPM":500,
        "$*friction":1.13,
        "$*dynamicFriction":1.15,
        "$*inertia":1.15,
        "$*engineBrakeTorque":1.1,

        "$*maxTorqueRating": 1.69,
        "$*maxOverTorqueDamage": 1.5,
    },
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>turbo_semi_01>turbo_bov",
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>turbo_semi_01>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>turbo_semi_01>turbo_spin",
        "bovEnabled":false,
        "bovSoundVolumeCoef": 0.0,
        "hissVolumePerPSI": 0.0,
        "whineVolumePer10kRPM": 0.09,
        "whinePitchPer10kRPM": 0.074,
        "wastegateStart":55,
        "wastegateLimit":57,
        "maxExhaustPower": 35000,
        "backPressureCoef": 0.00006,
        "frictionCoef": 23,
        "inertia":25,
        "damageThresholdTemperature": 850,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,          0],
            [30000,      8],
            [60000,     20],
            [90000,     39],
            [150000,    69],
            [200000,    78],
            [250000,    87],
            [300000,    93],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            // The gauge shows ~12 psi here. Keep the multiplier small so that
            // boost cannot push the 6000 Nm curve into engine damage.
            [0,     0.05,   0.20],
            [800,   0.05,   0.80],
            [5600,  0.05,   0.80],
        ],
    },
    "soundConfig": {
        "sampleName": "I6D_14900cc_01_1969_engine",
        "intakeMuffling": 0.8,

        "mainGain": -3,
        "onLoadGain": 1.0,
        "offLoadGain": 0.7,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": 0,
        "lowShelfFreq": 100,

        "highShelfGain":0,
        "highShelfFreq":4500,

        "eqLowGain": 0,
        "eqLowFreq": 350,
        "eqLowWidth": 0.25,

        "eqHighGain": 0,
        "eqHighFreq": 1400,
        "eqHighWidth": 0.1,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": 0,
    },
    "soundConfigExhaust": {
        "sampleName": "I6D_14900cc_01_1969_exhaust",

        "mainGain": 6,
        "onLoadGain": 1.0,
        "offLoadGain": 0.30,

        "maxLoadMix": 1.0,
        "minLoadMix": 0,

        "lowShelfGain": -10,
        "lowShelfFreq": 100,

        "highShelfGain": 6,
        "highShelfFreq": 2500,

        "eqLowGain": 0,
        "eqLowFreq": 100,
        "eqLowWidth": 0.1,

        "eqHighGain": 0,
        "eqHighFreq": 2400,
        "eqHighWidth": 0.1,

        "fundamentalFrequencyCylinderCount":6,
        "eqFundamentalGain": -12,
    },
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-1.00, 0, 1.00], //gearbox 1
        "friction": 5.9,
        "dynamicFriction": 0.00582,
        "torqueLossCoef": 0.014,

        "gearWhineCoefsInput":  [1.00, 0.00, 1.00],
        "gearWhineCoefsOutput": [0.00, 0.00, 1.00],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>semi_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>semi_01>twine_out",

        "forwardInputPitchCoef":1.4
        "forwardOutputPitchCoef":1.4

        "gearWhineInputPitchCoefSmoothing":75
        "gearWhineOutputPitchCoefSmoothing":75
        "gearWhineInputVolumeCoefSmoothing":20
        "gearWhineOutputVolumeCoefSmoothing":20

    },
    "clutch": {
        "uiName":"Clutch",
        "additionalEngineInertia":4,
        "clutchMass":32,
        "clutchFreePlay":0.2,
        "lockSpringCoef":0.8,
        "lockDampRatio":0.05,
        "lockTorque":100000000,
        "coolingCoef":1000
    },
    "vehicleController": {
        "automaticModes":"RND1",
        "useSmartAggressionCalculation":false,
        /*"calculateOptimalLoadShiftPoints":false*/,
        /*"transmissionGearChangeDelay":2*/,
        "gearboxDecisionSmoothingDown":2,
        "gearboxDecisionSmoothingUp":2,
        "throttleCoefWhileShifting": 1,

        "highShiftUpRPM":2200,
        /*"highShiftDownRPM":1600*/,
        /*"lowShiftUpRPM":1200*/,
        /*"lowShiftDownRPM":600*/,

        "clutchInRate":10,
        "clutchOutRate":10,
        "transmissionGearChangeDelay":0.25,
        "transmissionShiftDelay":0.3,
        "calculateOptimalLoadShiftPoints": false,
        "lowShiftDownRPM":[0,0,0,600,700,850,850,850,850,850,850,850],
        "lowShiftUpRPM":[0,0,2100,1950,1700,1550,1550,1550,1550,1550,1550],
        "highShiftDownRPM":[0,0,0,800,950,1150,1250,1250,1250,1250,1250,1250],
        "wheelSlipUpThreshold":900,
    },
    "rotators":[
        ["name","[group]:","node1:","node2:","nodeArm:","wheelDir"],
        {"radius":0.7526},
        {"rotatorType":"rotator"},
        {"enableBrakeThermals":false},
        {"brakeTorque":5000},
        {"parkingTorque":5000},
        {"useDefaultBrakeInput":true},
        {"speedo": false},
        ["propeller_L", ["propellerL"], "prop1l", "prop2l", "fh115", 1, {"speedo":false, "nodeCoupling:":"prop1l", "torqueCoupling:":"prop2l", "torqueArm:":"fh115"}],
        ["propeller_R", ["propellerR"], "prop1r", "prop2r", "fh115",-1, {"speedo":false, "nodeCoupling:":"prop1r", "torqueCoupling:":"prop2r", "torqueArm:":"fh115"}],
    ],
    "energyStorage": [
        ["type", "name"],
        ["fuelTank", "mainTank"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$fuel", "range", "L", "Chassis", 5000, 0, 5000, "Fuel Volume", "Initial fuel volume", {"stepDis":10}],
    ],
    "mainTank": {
        "energyType":"diesel",
        "fuelCapacity": 5000,
        "startingFuelCapacity": "$fuel",
        "breakTriggerBeam": "engine",
    },
    "nodes": [
        ["id",   "posX", "posY", "posZ"],
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        {"collision":true},
        {"selfCollision":true},

        {"group":""},
        {"nodeWeight":20},
        ["prop1l", 1.0000, 19.0711, -1.8500],
        ["prop2l", 1.0000, 20.0614, -1.8500],
        ["prop1r",-1.0000, 19.0711, -1.8500],
        ["prop2r",-1.0000, 20.0614, -1.8500],
        {"group":"propellerL"},
        ["prop3l", 0.4628, 19.4700, -2.3801],
        ["prop4l", 0.4576, 19.4700, -1.3105],
        ["prop5l", 1.5473, 19.4700, -1.2956],
        ["prop6l", 1.5324, 19.4700, -2.3853],
        ["prop7l", 1.0000, 19.7700, -2.6026],
        ["prop8l", 0.2400, 19.7700, -1.8500],
        ["prop9l", 1.0000, 19.7700, -1.0689],
        ["prop0l", 1.7600, 19.7700, -1.8500],
        {"group":"propellerR"},
        ["prop3r",-0.4628, 19.4700, -2.3801],
        ["prop4r",-0.4576, 19.4700, -1.3105],
        ["prop5r",-1.5473, 19.4700, -1.2956],
        ["prop6r",-1.5324, 19.4700, -2.3853],
        ["prop7r",-1.0000, 19.7700, -2.6026],
        ["prop8r",-0.2400, 19.7700, -1.8500],
        ["prop9r",-1.0000, 19.7700, -1.0689],
        ["prop0r",-1.7600, 19.7700, -1.8500],
        {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //prop
          {"beamSpring":2001000,"beamDamp":350},
          {"beamDeform":12400000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.2},

          //left
          ["prop1l", "prop2l"],

          ["prop1l", "prop3l"],
          ["prop1l", "prop4l"],
          ["prop1l", "prop5l"],
          ["prop1l", "prop6l"],
          ["prop2l", "prop3l"],
          ["prop2l", "prop4l"],
          ["prop2l", "prop5l"],
          ["prop2l", "prop6l"],

          ["prop1l", "prop7l"],
          ["prop1l", "prop8l"],
          ["prop1l", "prop9l"],
          ["prop1l", "prop0l"],
          ["prop2l", "prop7l"],
          ["prop2l", "prop8l"],
          ["prop2l", "prop9l"],
          ["prop2l", "prop0l"],

          ["prop3l", "prop4l"],
          ["prop3l", "prop5l"],
          ["prop3l", "prop6l"],
          ["prop4l", "prop5l"],
          ["prop4l", "prop6l"],
          ["prop5l", "prop6l"],

          ["prop7l", "prop8l"],
          ["prop7l", "prop9l"],
          ["prop7l", "prop0l"],
          ["prop8l", "prop9l"],
          ["prop8l", "prop0l"],
          ["prop9l", "prop0l"],

          ["prop3l", "prop8l"],
          ["prop3l", "prop9l"],
          ["prop3l", "prop0l"],
          ["prop4l", "prop9l"],
          ["prop4l", "prop0l"],
          ["prop5l", "prop0l"],

          ["prop7l", "prop4l"],
          ["prop7l", "prop5l"],
          ["prop7l", "prop6l"],
          ["prop8l", "prop5l"],
          ["prop8l", "prop6l"],
          ["prop9l", "prop6l"],

          //right
          ["prop1r", "prop2r"],

          ["prop1r", "prop3r"],
          ["prop1r", "prop4r"],
          ["prop1r", "prop5r"],
          ["prop1r", "prop6r"],
          ["prop2r", "prop3r"],
          ["prop2r", "prop4r"],
          ["prop2r", "prop5r"],
          ["prop2r", "prop6r"],

          ["prop1r", "prop7r"],
          ["prop1r", "prop8r"],
          ["prop1r", "prop9r"],
          ["prop1r", "prop0r"],
          ["prop2r", "prop7r"],
          ["prop2r", "prop8r"],
          ["prop2r", "prop9r"],
          ["prop2r", "prop0r"],

          ["prop3r", "prop4r"],
          ["prop3r", "prop5r"],
          ["prop3r", "prop6r"],
          ["prop4r", "prop5r"],
          ["prop4r", "prop6r"],
          ["prop5r", "prop6r"],

          ["prop7r", "prop8r"],
          ["prop7r", "prop9r"],
          ["prop7r", "prop0r"],
          ["prop8r", "prop9r"],
          ["prop8r", "prop0r"],
          ["prop9r", "prop0r"],

          ["prop3r", "prop8r"],
          ["prop3r", "prop9r"],
          ["prop3r", "prop0r"],
          ["prop4r", "prop9r"],
          ["prop4r", "prop0r"],
          ["prop5r", "prop0r"],

          ["prop7r", "prop4r"],
          ["prop7r", "prop5r"],
          ["prop7r", "prop6r"],
          ["prop8r", "prop5r"],
          ["prop8r", "prop6r"],
          ["prop9r", "prop6r"],

          //attach
          {"beamSpring":2001000,"beamDamp":350},
          {"beamDeform":12400000,"beamStrength":6200000},
          {"breakGroup":"propeller_L"},
          ["prop1l", "fh106", {"name":"propeller_L"}],
          ["prop1l", "fh115"],
          ["prop1l", "fhr114"],
          ["prop1l", "fhl114"],
          ["prop2l", "fh106"],
          ["prop2l", "fh115"],
          {"breakGroup":"propeller_R"},
          ["prop1r", "fh106", {"name":"propeller_R"}],
          ["prop1r", "fh115"],
          ["prop1r", "fhr114"],
          ["prop1r", "fhl114"],
          ["prop2r", "fh106"],
          ["prop2r", "fh115"],
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":2001000,"beamDamp":350},
        {"beamDeform":12400000,"beamStrength":6200000},
        {"breakGroup":"propeller_L"},
        ["prop2l", "fhr114", {"factor":-0.125,"steeringWheelLock":495, "inRate":1.25,"outRate":1.25}],
        ["prop2l", "fhl114", {"factor": 0.125,"steeringWheelLock":495, "inRate":1.25,"outRate":1.25}],
        {"breakGroup":"propeller_R"},
        ["prop2r", "fhr114", {"factor":-0.125,"steeringWheelLock":495, "inRate":1.25,"outRate":1.25}],
        ["prop2r", "fhl114", {"factor": 0.125,"steeringWheelLock":495, "inRate":1.25,"outRate":1.25}],
        {"breakGroup":""},
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
          ["id1:", "id2:", "id3:"],
          // Was 200. That load stalled a healthy engine near 2000 rpm and
          // broke the engine once the crank curve was raised to match it.
          {"dragCoef":80},
		  {"liftCoef":80},
          {"group":"propeller_L"},
          ["prop1l", "prop7l", "prop3l"],
          ["prop1l", "prop8l", "prop4l"],
          ["prop1l", "prop9l", "prop5l"],
          ["prop1l", "prop0l", "prop6l"],
          {"group":"propeller_R"},
          ["prop1r", "prop3r", "prop7r"],
          ["prop1r", "prop4r", "prop8r"],
          ["prop1r", "prop5r", "prop9r"],
          ["prop1r", "prop6r", "prop0r"],
    ],
},

