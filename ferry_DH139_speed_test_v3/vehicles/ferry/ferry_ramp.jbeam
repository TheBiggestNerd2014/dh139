{
"ferry_ramp":{
	"information":{
		"authors":"JGB",
		"name":"Ferry Ramp",
		"value":2000,
	},
	"slotType":"ferry_ramp",
	
	
	"flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
		 ["ferry_ramp", ["ferry_ramp"]],
		],
		
	



//--Nodes--
	"nodes":[
		["id", "posX", "posY", "posZ"],
		{"collision":true},
		{"selfCollision":false},
		{"group":"ferry_ramp"},
		{"nodeWeight":50},
		{"dragCoef":10},
		
		//LEFT
		["frl2",4.088,-20.0251,3.899],
		["frl3",3.8135,-19.5178,3.5968],
		["frl0",4.042,-16.4621,-0.19],
		["frl1",3.8479,-16.315,0.0882],
		["fr0",0.0,-16.655,-0.19],
		["fr1",0.0,-16.655,0.078],
		["frr2",-4.088,-20.0251,3.899],
		["frr3",-3.7942,-19.5178,3.5968],
		["frr0",-4.042,-16.4621,-0.19],
		["frr1",-3.8575,-16.2873,0.0881],
		// Center of the deck edge and the ramp face, so the mesh follows the hinge.
		["fr2", 0.0, -20.0251, 3.899],
		["fr3", 0.0, -19.4732, 3.5621],

		{"group":""},
		{"collision":false},
		{"selfCollision":false},
		{"nodeWeight":80},
		{"dragCoef":0},
		// Cylinder mounts, above the stowed ramp. Not colliders.
		["ral", 4.042, -17.7, 3.1],
		["rar", -4.042, -17.7, 3.1],
	],
//--Beams--
	"beams":[
		["id1:", "id2:"],
		{"disableMeshbreaking":"true"},
		{"beamSpring":10000000,"beamDamp":80, "beamDeform":"FLT_MAX","beamStrength": "FLT_MAX"},
        ["frr2","frr0"],
        ["frr3","frr1"],
        ["frr2","frr3"],
        ["frr0","frr1"],
        ["frr2","frr1"],
        ["frr3","frr0"],
        ["fr1","frr1"],
        ["fr0","frr0"],
        ["fr1","frr0"],
        ["fr0","fr1"],
        ["fr0","frr1"],
        ["frl1","fr1"],
        ["frl0","frl1"],
        ["frl0","fr1"],
        ["frl0","fr0"],
        ["frl1","fr0"],
        ["frl3","frl1"],
        ["frl2","frl3"],
        ["frl2","frl0"],
        ["frl3","frl0"],
        ["frl2","frl1"],
        ["frl3","frr3"],
        ["frl2","frr2"],
        ["frl3","frr2"],
        ["frl2","frr3"],
        ["frl2","frr0"],
        ["frl0","frr2"],
        ["frl1","frr3"],
        ["frl3","frr1"],
		
		["fr1","frr3"],
        ["frl3","fr1"],
        ["frl2","fr0"],
        ["fr0","frr2"],
		["frl2","frr1"],
        ["frl3","frr0"],
        ["frl0","frr3"],
        ["frl1","frr2"],
		
		
		
		// Center nodes stay on the rigid ramp.
		["fr2","frl2"],
		["fr2","frr2"],
		["fr2","frl0"],
		["fr2","frr0"],
		["fr2","fr0"],
		["fr3","fr2"],
		["fr3","frl3"],
		["fr3","frr3"],
		["fr3","frl2"],
		["fr3","frr2"],
		["fr3","fr0"],
		["fr3","fr1"],

		// Hinge the deck edge to the bow. The lip swings on this axis.
		{"beamSpring":1500000,"beamDamp":200, "beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
		{"breakGroup":"ramp"},
		{"breakGroupType":1},
		["frl2","fhl0"],
		["frl2","fhl1"],
		["frl2","fhl2"],
		["frr2","fhr0"],
		["frr2","fhr1"],
		["frr2","fhr2"],
		["fr2","fhl0"],
		["fr2","fhr0"],
		["ral","fhl0"],
		["ral","fhl1"],
		["ral","fhl4"],
		["rar","fhr0"],
		["rar","fhr1"],
		["rar","fhr4"],
    
   
       
		
		
		
        
        
       
        
	],
	
	
	"hydros": [
		["id1:","id2:"],
		// Bow cylinders. ramp_lift 0 keeps the authored length. 1 extends them
		// to 1.96x, which swings the lip forward and down to the water.
		// No "factor": that key replaces inLimit/outLimit and was collapsing the travel.
		// Long bound stays above the extended length so the hard limit does not fight the cylinder.
		{"beamPrecompression":1.0, "beamLongBound":2.4, "beamShortBound":0.9},
		{"beamSpring":400000,"beamDamp":400,"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
		{"breakGroup":"ramp"},
		{"breakGroupType":1},
		["ral", "frl0", {"inputSource":"ramp_lift","inLimit":0,"outLimit":1.96,"inRate":0.15,"outRate":0.15,"inputFactor":0.96}],
		["rar", "frr0", {"inputSource":"ramp_lift","inLimit":0,"outLimit":1.96,"inRate":0.15,"outRate":0.15,"inputFactor":0.96}],
	],
	
	
//--Collision Triangles--
	"triangles":[
		["id1:", "id2:", "id3:"],
		{"dragCoef":30},
		{"collision":true},
		{"selfCollision":false},
		{"groundModel":"metal"},
        ["frr0","fr0","frr2"],
        ["frl0","frl2","fr0"],
        ["fr0","frl2","frr2"],
        ["frl3","frr3","frl2"],
        ["frr2","frl2","frr3"],
        ["frl1","fr1","frl3"],
        ["fr1","frr3","frl3"],
        ["frr1","frr3","fr1"],
        ["frr2","frr3","frr0"],
        ["frr1","frr0","frr3"],
        ["frl2","frl0","frl3"],
        ["frl1","frl3","frl0"],
	],
},
}